<full-backup-content>
    <!-- Local accounts, session state and learning history must never leave the device. -->
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
